# Verified official linux/amd64 platform manifest; recorded in p0a-verification.md.
FROM rust:1.97.0-bookworm@sha256:b5a086f64ffecaa4e283063184770107915756739598173e1f5712d6b34b84d0
WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY migrations ./migrations
COPY contracts ./contracts
COPY deploy/fixture-runner ./deploy/fixture-runner
COPY deploy/fixtures ./deploy/fixtures
COPY deploy/bootstrap-fixtures.sh ./deploy/bootstrap-fixtures.sh
COPY deploy/run-tests.sh /run-tests.sh
COPY deploy/c3-env.sh deploy/c3-databases.json ./deploy/
COPY deploy/c3-manage.sh /c3-manage.sh
RUN cargo build --locked --manifest-path deploy/fixture-runner/Cargo.toml
RUN cargo test --locked --workspace --no-run
ENTRYPOINT ["sh", "/run-tests.sh"]

RUN cargo build --locked -p learning-worker --bin learning-worker --example c3_acceptance
RUN chown -R 65532:65532 /app "$CARGO_HOME"
