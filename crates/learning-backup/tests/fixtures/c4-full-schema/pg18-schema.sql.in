    target_object_id uuid NOT NULL,
    target_revision_id uuid NOT NULL,
    CONSTRAINT reference_dependency_position_check CHECK (("position" >= 0)),
    CONSTRAINT reference_dependency_role_check CHECK ((role = ANY (ARRAY['basis'::text, 'target'::text, 'requires_context'::text, 'source_run'::text, 'selected_relation'::text, 'selected_review'::text])))
);


