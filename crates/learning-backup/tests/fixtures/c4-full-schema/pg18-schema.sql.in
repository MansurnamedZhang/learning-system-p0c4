-- Name: request_key; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.request_key (
    actor_id uuid NOT NULL,
    request_id uuid NOT NULL,
    request_sha256 text NOT NULL,
    operation text NOT NULL,
    CONSTRAINT request_key_operation_check CHECK ((operation = ANY (ARRAY['content_v1'::text, 'composition_save'::text, 'release_publish'::text, 'reading_create'::text, 'reading_edit'::text, 'migration_propose'::text, 'migration_decide'::text, 'content_v2'::text, 'relation_save'::text, 'relation_review'::text, 'epistemic_review'::text, 'reading_select'::text, 'release_publish_evidence'::text, 'lineage_apply'::text, 'asset_register'::text, 'content_v3'::text, 'snapshot_export'::text]))),
    CONSTRAINT request_key_request_sha256_check CHECK ((request_sha256 ~ '^[0-9a-f]{64}$'::text))
);


--
-- Name: resource; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.resource (
    space_id uuid NOT NULL,
    id uuid NOT NULL,
    display_name text NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT resource_display_name_check CHECK ((((char_length(display_name) >= 1) AND (char_length(display_name) <= 255)) AND (btrim(display_name) <> ''::text)))
);


--
-- Name: resource_version; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.resource_version (
    space_id uuid NOT NULL,
    resource_id uuid NOT NULL,
    id uuid NOT NULL,
    asset_id uuid NOT NULL,
    version_no integer NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT resource_version_version_no_check CHECK ((version_no > 0))
);


--
-- Name: snapshot_export_request; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.snapshot_export_request (
    actor_id uuid NOT NULL,
    request_id uuid NOT NULL,
    outbox_id uuid NOT NULL,
    job_id uuid NOT NULL
);


--
-- Name: snapshot_export_result; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.snapshot_export_result (
    job_id uuid NOT NULL,
    stage_token uuid NOT NULL,
    capability text NOT NULL,
    manifest_sha256 text NOT NULL,
    plan_sha256 text NOT NULL,
    required_spaces uuid[] NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT snapshot_export_result_capability_check CHECK ((capability = ANY (ARRAY['exact_import_v1'::text, 'reading_copy_v1'::text]))),
    CONSTRAINT snapshot_export_result_manifest_sha256_check CHECK ((manifest_sha256 ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT snapshot_export_result_plan_sha256_check CHECK ((plan_sha256 ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT snapshot_export_result_required_spaces_check CHECK ((cardinality(required_spaces) > 0))
);


--
-- Name: snapshot_import_batch; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.snapshot_import_batch (
    actor_id uuid NOT NULL,
    request_id uuid NOT NULL,
    manifest_sha256 text NOT NULL,
    status text DEFAULT 'succeeded'::text NOT NULL,
    CONSTRAINT snapshot_import_batch_manifest_sha256_check CHECK ((manifest_sha256 ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT snapshot_import_batch_status_check CHECK ((status = 'succeeded'::text))
);


--
-- Name: source_segment; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.source_segment (
    space_id uuid NOT NULL,
    resource_id uuid NOT NULL,
    resource_version_id uuid NOT NULL,
    id uuid NOT NULL,
    selector jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT source_segment_selector_check CHECK (((jsonb_typeof(selector) = 'object'::text) AND (octet_length((selector)::text) <= 16000)))
);


