--

CREATE TABLE public.epistemic_stream (
    id uuid NOT NULL,
    space_id uuid NOT NULL,
    overlay_id uuid,
    target_space_id uuid NOT NULL,
    target_block_id uuid NOT NULL,
    target_revision_id uuid NOT NULL,
    actor_id uuid NOT NULL,
    head_review_id uuid NOT NULL
);


--
-- Name: job; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.job (
    id uuid NOT NULL,
    outbox_id uuid CONSTRAINT job_outbox_id_not_null1 NOT NULL,
    idempotency_key text NOT NULL,
    status text NOT NULL,
    attempt_count integer DEFAULT 0 NOT NULL,
    lease_token uuid,
    lease_expires_at timestamp with time zone,
    next_attempt_at timestamp with time zone,
    last_error_class text,
    output_digest text,
    checkpoint jsonb,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    updated_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT job_attempt_count_check CHECK ((attempt_count >= 0)),
    CONSTRAINT job_check CHECK ((((status = ANY (ARRAY['running'::text, 'snapshot_running'::text])) AND (attempt_count > 0) AND (lease_token IS NOT NULL) AND (lease_expires_at IS NOT NULL)) OR ((status <> ALL (ARRAY['running'::text, 'snapshot_running'::text])) AND (lease_token IS NULL) AND (lease_expires_at IS NULL)))),
    CONSTRAINT job_check1 CHECK ((((status = ANY (ARRAY['retry_wait'::text, 'snapshot_retry_wait'::text])) AND (next_attempt_at IS NOT NULL)) OR ((status <> ALL (ARRAY['retry_wait'::text, 'snapshot_retry_wait'::text])) AND (next_attempt_at IS NULL)))),
    CONSTRAINT job_check2 CHECK (((status <> ALL (ARRAY['queued'::text, 'snapshot_queued'::text])) OR ((attempt_count = 0) AND (last_error_class IS NULL) AND (output_digest IS NULL) AND (checkpoint IS NULL)))),
    CONSTRAINT job_checkpoint_check CHECK (((checkpoint IS NULL) OR ((jsonb_typeof(checkpoint) = 'object'::text) AND (octet_length((checkpoint)::text) <= 16384)))),
    CONSTRAINT job_last_error_class_check CHECK (((last_error_class IS NULL) OR (((char_length(last_error_class) >= 1) AND (char_length(last_error_class) <= 80)) AND (last_error_class ~ '^[a-z][a-z0-9_]*$'::text)))),
    CONSTRAINT job_output_digest_check CHECK (((output_digest IS NULL) OR (output_digest ~ '^[0-9a-f]{64}$'::text))),
    CONSTRAINT job_status_check CHECK ((status = ANY (ARRAY['queued'::text, 'running'::text, 'retry_wait'::text, 'snapshot_queued'::text, 'snapshot_running'::text, 'snapshot_retry_wait'::text, 'succeeded'::text, 'failed'::text, 'cancelled'::text])))
);


--
-- Name: job_outbox; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.job_outbox (
    id uuid NOT NULL,
    business_key text NOT NULL,
    event_type text NOT NULL,
    payload_version integer NOT NULL,
    payload jsonb NOT NULL,
    actor_id uuid NOT NULL,
    processor_version integer NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    dispatched_at timestamp with time zone,
    CONSTRAINT job_outbox_business_key_check CHECK ((((char_length(business_key) >= 1) AND (char_length(business_key) <= 255)) AND (business_key = btrim(business_key)))),
    CONSTRAINT job_outbox_check CHECK (public.p0c3_valid_job_payload(event_type, payload_version, payload, actor_id, business_key)),
    CONSTRAINT job_outbox_event_type_check CHECK ((event_type = ANY (ARRAY['asset_integrity_requested'::text, 'snapshot_export_requested'::text]))),
    CONSTRAINT job_outbox_payload_version_check CHECK ((payload_version = 1)),
    CONSTRAINT job_outbox_processor_version_check CHECK ((processor_version = 1))
);


--
-- Name: lineage_input; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.lineage_input (
    operation_id uuid NOT NULL,
    "position" integer NOT NULL,
    space_id uuid NOT NULL,
    block_id uuid NOT NULL,
    revision_id uuid NOT NULL,
    CONSTRAINT lineage_input_position_check CHECK ((("position" >= 0) AND ("position" <= 31)))
);


--
-- Name: lineage_operation; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.lineage_operation (
    id uuid NOT NULL,
    space_id uuid NOT NULL,
    operation text NOT NULL,
    author_id uuid NOT NULL,
    reason text NOT NULL,
    input_count integer NOT NULL,
    output_count integer NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT lineage_operation_check CHECK ((((operation = 'derive'::text) AND (input_count = 1) AND (output_count = 1)) OR ((operation = 'split'::text) AND (input_count = 1) AND ((output_count >= 2) AND (output_count <= 32))) OR ((operation = 'merge'::text) AND ((input_count >= 2) AND (input_count <= 32)) AND (output_count = 1)))),
    CONSTRAINT lineage_operation_operation_check CHECK ((operation = ANY (ARRAY['derive'::text, 'split'::text, 'merge'::text]))),
    CONSTRAINT lineage_operation_reason_check CHECK ((((char_length(reason) >= 1) AND (char_length(reason) <= 1000)) AND (btrim(reason) <> ''::text)))
);


--
-- Name: lineage_output; Type: TABLE; Schema: public; Owner: -
