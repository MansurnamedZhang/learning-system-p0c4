    group_id uuid NOT NULL,
    classification text NOT NULL,
    candidate jsonb,
    reason_code text NOT NULL,
    CONSTRAINT placement_migration_group_check CHECK ((((classification = 'unresolved'::text) AND (candidate IS NULL)) OR ((classification <> 'unresolved'::text) AND (candidate IS NOT NULL)))),
    CONSTRAINT placement_migration_group_classification_check CHECK ((classification = ANY (ARRAY['exact'::text, 'candidate'::text, 'unresolved'::text])))
);


