CREATE INDEX job_outbox_undispatched ON public.job_outbox USING btree (created_at, id) WHERE (dispatched_at IS NULL);


--
-- Name: job_runnable; Type: INDEX; Schema: public; Owner: -
--

CREATE INDEX job_runnable ON public.job USING btree (status, next_attempt_at, created_at, id) WHERE (status = ANY (ARRAY['queued'::text, 'retry_wait'::text, 'running'::text]));


--
-- Name: job_snapshot_runnable; Type: INDEX; Schema: public; Owner: -
--

CREATE INDEX job_snapshot_runnable ON public.job USING btree (status, next_attempt_at, created_at, id) WHERE (status = ANY (ARRAY['snapshot_queued'::text, 'snapshot_retry_wait'::text, 'snapshot_running'::text]));


