    type text NOT NULL,
    origin text DEFAULT 'user_asserted'::text NOT NULL,
    from_block_id uuid NOT NULL,
    to_block_id uuid NOT NULL,
    head_revision_id uuid NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT relation_check CHECK ((from_block_id <> to_block_id)),
    CONSTRAINT relation_check1 CHECK (((type <> 'related_to'::text) OR (from_block_id < to_block_id))),
    CONSTRAINT relation_origin_check CHECK ((origin = 'user_asserted'::text)),
    CONSTRAINT relation_type_check CHECK ((type = ANY (ARRAY['annotates'::text, 'questions'::text, 'answers'::text, 'inspired_by'::text, 'supports'::text, 'opposes'::text, 'tests'::text, 'related_to'::text])))
);


