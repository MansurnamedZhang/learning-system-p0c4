    source_space_id uuid NOT NULL,
    root_composition_id uuid NOT NULL,
    base_revision_id uuid NOT NULL,
    placed_base_revision_id uuid,
    parent_path uuid[] NOT NULL,
    left_id uuid,
    right_id uuid,
    affinity text NOT NULL,
    CONSTRAINT overlay_group_affinity_check CHECK ((affinity = ANY (ARRAY['after_left'::text, 'before_right'::text]))),
    CONSTRAINT overlay_group_check CHECK (((placed AND (placed_base_revision_id IS NOT NULL) AND (placed_base_revision_id = base_revision_id)) OR ((NOT placed) AND (placed_base_revision_id IS NULL)))),
    CONSTRAINT overlay_group_check1 CHECK (((left_id IS NULL) OR (right_id IS NULL) OR (left_id <> right_id))),
    CONSTRAINT overlay_group_parent_path_check CHECK (((cardinality(parent_path) <= 15) AND (array_position(parent_path, NULL::uuid) IS NULL)))
);


