    evidence jsonb,
    CONSTRAINT reading_evidence_version CHECK ((((contract_version = 1) AND (evidence IS NULL)) OR ((contract_version = 2) AND (evidence IS NOT NULL)))),
    CONSTRAINT reading_view_revision_check CHECK (((parent_revision_id IS NULL) OR (parent_revision_id <> id))),
    CONSTRAINT reading_view_revision_contract_version_check CHECK ((contract_version = ANY (ARRAY[1, 2])))
);


